{
  "rules": {
    /* 
      Stock Portfolio Tracker - Firebase Realtime Database 安全規則規範
      
      1. 根目錄閉鎖：禁止遍歷或列舉整個資料庫 (.read: false, .write: false)
      2. 統計遙測節點 (stats)：開放即時下載次數與更新頻率原子計數 (.read: true, .write: true，零個資)
      3. 端到端加密庫存 (portfolios)：
         - 獨立路徑讀取：僅已知專屬 user_id 者可讀取其加密密文
         - 寫入憑證防禦：初次寫入隨機生成 write_token，後續覆寫必須匹配相同 token
         - 格式驗證：強制要求 ciphertext_b64, salt_hex, nonce_hex, write_token, sync_seq 等欄位
    */
    ".read": false,
    ".write": false,

    "stats": {
      ".read": true,
      ".write": true
    },

    "portfolios": {
      ".read": false,
      ".write": false,
      "$user_id": {
        ".read": true,
        ".write": "!data.exists() || (newData.child('write_token').val() === data.child('write_token').val())",
        ".validate": "newData.hasChildren(['ciphertext_b64', 'salt_hex', 'nonce_hex', 'write_token', 'sync_seq'])"
      }
    }
  }
}
