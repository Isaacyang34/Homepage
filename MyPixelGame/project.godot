; Engine configuration file.
; Godot 4.x 修仙傳 MyPixelGame 完整專案設置

config_version=5

[application]

config/name="修仙傳 · MyPixelGame"
config/description="修仙主題 2D 像素動作 RPG —— 集修仙境界、打坐吐納、御劍天劫於一體"
run/main_scene="res://src/level/MainLevel.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/sprites/icon.png"

[autoload]

EventBus="*res://src/core/EventBus.gd"
GameManager="*res://src/core/GameManager.gd"
AudioManager="*res://src/core/AudioManager.gd"
CultivationManager="*res://src/systems/CultivationManager.gd"
InventoryManager="*res://src/systems/InventoryManager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/size/resizable=true

